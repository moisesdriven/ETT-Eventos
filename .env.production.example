# Copiar a .env en el servidor (nunca subir este archivo con valores al repositorio).

# Dominio público (Traefik emite el certificado)
APP_DOMAIN=eventos.tudominio.com

# Traefik existente en el servidor
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# PostgreSQL propio del stack (contraseña larga y aleatoria)
# Generar con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=ett
POSTGRES_PASSWORD=
POSTGRES_DB=ett
BACKUP_KEEP_DAYS=14

# GoHighLevel (solo los usa el worker)
GHL_AGENCY_TOKEN=
GHL_LOCATION_TOKEN=
GHL_LOCATION_ID=
GHL_COMPANY_ID=

# Worker
SYNC_INTERVAL_MINUTES=15
DAILY_JOBS_HOUR_LIMA=3
