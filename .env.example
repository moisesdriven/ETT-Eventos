# --- Base de datos (PostgreSQL propio del stack) ---
DATABASE_URL=postgres://ett:ett@localhost:5432/ett

# --- Seguridad ---
# Clave de 32 bytes en base64 para cifrar datos sensibles (AES-256-GCM).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# URL pública de la app (se usa para validar el origen en peticiones que modifican datos)
APP_URL=http://localhost:3000

# --- Primer administrador (solo para pnpm db:create-admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- GoHighLevel (solo servidor / worker; nunca en el navegador) ---
GHL_AGENCY_TOKEN=
GHL_LOCATION_TOKEN=
GHL_LOCATION_ID=
